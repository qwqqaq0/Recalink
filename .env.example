# Local API port and extension authentication
PORT=3210
EXTENSION_API_TOKEN=replace-with-a-long-random-token
# Optional comma-separated extension origins, for example chrome-extension://<id>
EXTENSION_ORIGINS=

# Docker Compose defaults
POSTGRES_DB=bookmark_recall
POSTGRES_USER=bookmark_recall
POSTGRES_PASSWORD=bookmark_recall_local_only
MEILI_MASTER_KEY=replace-with-a-long-meilisearch-key

# Optional OpenAI-compatible /chat/completions endpoint. AI is enabled only
# when all three values are present.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=15000

# Override these for non-Docker local development.
DATABASE_URL=postgres://bookmark_recall:bookmark_recall_local_only@127.0.0.1:5432/bookmark_recall
MEILI_URL=http://127.0.0.1:7700
WEB_ROOT=apps/web/dist
MIGRATIONS_DIR=packages/db/migrations
