{
  "name": "bookmark-recall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev:api": "npm run dev -w @bookmark-recall/api",
    "dev:worker": "npm run dev -w @bookmark-recall/worker",
    "dev:web": "npm run dev -w @bookmark-recall/web",
    "build:extension": "npm run build -w @bookmark-recall/extension",
    "db:migrate": "npm run migrate -w @bookmark-recall/db",
    "eval:search": "tsx scripts/evaluate-search.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
