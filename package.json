{
  "name": "recalink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "dev:api": "npm run dev -w @recalink/api",
    "dev:worker": "npm run dev -w @recalink/worker",
    "dev:web": "npm run dev -w @recalink/web",
    "build:extension": "npm run build -w @recalink/extension",
    "db:migrate": "npm run migrate -w @recalink/db",
    "eval:search": "tsx scripts/evaluate-search.ts",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
