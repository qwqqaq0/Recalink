{
  "services": {
    "postgres": {
      "image": "postgres:16-alpine",
      "environment": {
        "POSTGRES_DB": "recalink_smoke",
        "POSTGRES_USER": "smoke",
        "POSTGRES_PASSWORD": "smoke_test_only"
      },
      "volumes": [
        {
          "type": "volume",
          "source": "postgres-data",
          "target": "/var/lib/postgresql/data"
        }
      ],
      "healthcheck": {
        "test": ["CMD-SHELL", "pg_isready -U smoke -d recalink_smoke"],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20
      }
    },
    "meilisearch": {
      "image": "getmeili/meilisearch:v1.13",
      "environment": {
        "MEILI_ENV": "production",
        "MEILI_NO_ANALYTICS": "true",
        "MEILI_MASTER_KEY": "recalink_smoke_meili_test_only"
      },
      "volumes": [
        { "type": "volume", "source": "meili-data", "target": "/meili_data" }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "--spider",
          "-q",
          "http://127.0.0.1:7700/health"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 30
      }
    },
    "api": {
      "build": ".",
      "environment": {
        "DATABASE_URL": "postgres://smoke:smoke_test_only@postgres:5432/recalink_smoke",
        "MEILI_URL": "http://meilisearch:7700",
        "MEILI_MASTER_KEY": "recalink_smoke_meili_test_only",
        "EXTENSION_API_TOKEN": "recalink_smoke_extension_test_only",
        "EXTENSION_ORIGINS": "",
        "AI_BASE_URL": "",
        "AI_API_KEY": "",
        "AI_MODEL": "",
        "WEB_ROOT": "/app/apps/web/dist",
        "MIGRATIONS_DIR": "/app/packages/db/migrations",
        "PORT": "3210",
        "RECALINK_SMOKE_ISOLATED": "1",
        "SMOKE_API_URL": "http://127.0.0.1:3210"
      },
      "depends_on": {
        "postgres": { "condition": "service_healthy" },
        "meilisearch": { "condition": "service_healthy" }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3210/api/v1/health').then(r=>{if(!r.ok)process.exit(1)})"
        ],
        "interval": "5s",
        "timeout": "4s",
        "retries": 30
      }
    },
    "worker": {
      "build": ".",
      "command": ["node", "apps/worker/dist/index.js"],
      "environment": {
        "DATABASE_URL": "postgres://smoke:smoke_test_only@postgres:5432/recalink_smoke",
        "MEILI_URL": "http://meilisearch:7700",
        "MEILI_MASTER_KEY": "recalink_smoke_meili_test_only",
        "EXTENSION_API_TOKEN": "recalink_smoke_extension_test_only",
        "AI_BASE_URL": "",
        "AI_API_KEY": "",
        "AI_MODEL": "",
        "RECALINK_SMOKE_ISOLATED": "1",
        "SMOKE_API_URL": "http://127.0.0.1:3210"
      },
      "depends_on": {
        "postgres": { "condition": "service_healthy" },
        "meilisearch": { "condition": "service_healthy" },
        "api": { "condition": "service_healthy" }
      }
    }
  },
  "volumes": { "postgres-data": {}, "meili-data": {} }
}
